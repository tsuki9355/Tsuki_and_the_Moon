# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Unused Third Person template content (Tsuki only depends on Content/Characters/Mannequins)
Content/ThirdPerson/
Content/LevelPrototyping/
Content/Input/
Content/Variant_*/
Content/__ExternalActors__/ThirdPerson/
Content/__ExternalActors__/Variant_*/
Content/__ExternalObjects__/ThirdPerson/
Content/__ExternalObjects__/Variant_*/
Content/Collections/
Content/Developers/

# Raw source art (FBX/PNG exports); only imported Unreal assets are committed
Tsuki_and_the_Moon_assets/

# Game Animation Sample content migrated in for retargeting only (not redistributed)
Content/Audio/
Content/Blueprints/
Content/Characters/Echo/
Content/Characters/Paragon/
Content/Characters/UE4_Mannequin/
Content/Characters/UE5_Mannequins/
Content/Characters/UEFN_Mannequin/
Content/Levels/
Content/MetaHumans/
Content/Misc/
Content/Tsuki/M_Neutral_*.uasset
Content/Tsuki/LookAtPOI_*.uasset


# Packaged builds and jam zips
/Game/
